FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    tensorflow \
    keras \
    numpy \
    pandas \
    pydantic \
    confluent-kafka \
    pyarrow

COPY src/ src/

ENV PYTHONPATH=/app/src
EXPOSE 8000

# data/models and data/processed are mounted at runtime via volume
CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
