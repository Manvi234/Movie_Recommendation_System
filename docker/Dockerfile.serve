FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn[standard] tensorflow numpy pandas pydantic confluent-kafka

COPY src/serving/ src/serving/
COPY src/evaluation/ src/evaluation/
COPY data/models/ data/models/
COPY data/processed/ data/processed/
COPY data/raw/ml-latest-small/movies.csv data/raw/ml-latest-small/

ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
